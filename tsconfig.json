{
 "compilerOptions": {
  "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
  "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
  "strict": true, "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
  "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
  "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
  "allowImportingTsExtensions": true, "types": ["vite/client"]
 },
 "include": ["src", "tests", "vite.config.ts"]
}
