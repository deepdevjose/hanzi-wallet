{
  "name": "hanzi-wallet",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Mandarin character practice by HSK level with an offline writing studio.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build_offline.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "train": "python3 scripts/train_model.py",
    "evaluate": "python3 scripts/train_model.py --evaluate-only",
    "build:dictionary": "node scripts/build_common_dictionary.mjs"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "hanzi-writer-data": "2.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
